# Copy to .env and adjust. docker compose reads this file automatically.

POSTGRES_USER=verdantis
POSTGRES_PASSWORD=verdantis
POSTGRES_DB=verdantis

# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-longo

# 32 random bytes in base64, used to sign traceability certificates.
# Generate with: openssl rand -base64 32
# Leave empty in development to use a temporary key.
SIGNING_KEY_SEED=

# Where the browser reaches the API and the web app.
API_PUBLIC_URL=http://localhost:8080
WEB_PUBLIC_URL=http://localhost:3000
